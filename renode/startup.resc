:name: STM32 Rust Renode
:description: This script runs the rust generated binary on renode

$name?="STM32Rust"
$bin_path?=@target/thumbv7em-none-eabihf/debug/rust-sandbox
$platform_path?=@platforms/boards/stm32f4_discovery.repl

# Create Machine & Load config
mach create $name
echo "Machine created"
machine LoadPlatformDescription $platform_path
echo "Platform loaded"

echo "Load ELF file"
sysbus LoadELF $bin_path

# Logging
logLevel -1 gpioPortD.UserLED
# sysbus.cpu LogFunctionNames true
# sysbus LogAllPeripheralsAccess true

# Start the machine
machine StartGdbServer 3333

# Print some helpful information
echo ""
echo "Emulation started."
echo "To pause emulation, use: 'pause'"
echo "To resume emulation, use: 'start'"
echo "To press button, use: 'gpioPortA.UserButton Press'"
echo "To release button, use: 'gpioPortA.UserButton Release'"
echo "To press release button, use: 'gpioPortA.UserButton PressAndRelease'"
echo ""